# Django Settings
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL for production)
DB_ENGINE=postgresql
DB_NAME=firedb
DB_USER=fireuser
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# YOLO Settings
YOLO_WEIGHTS_PATH=../YOLO-FIRE/weights/best.pt
CAMERA_SOURCE=0
YOLO_CONF=0.30
YOLO_IOU=0.50
YOLO_IMGSZ=416
YOLO_INFER_INTERVAL=0.12
YOLO_USE_FP16=False
YOLO_WARMUP_ITERATIONS=3

# Stream Settings
STREAM_JPEG_QUALITY=72
STREAM_TARGET_FPS=20
STREAM_INPUT_MAX_WIDTH=960
STREAM_FRAME_SKIP=0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=30

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# File Upload
MAX_VIDEO_UPLOAD_MB=100

# Monitoring
ENABLE_PROMETHEUS_METRICS=True
